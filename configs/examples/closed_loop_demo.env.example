# Closed-loop demo example configuration.
# Copy to a local ignored file before use.

QWEN3_SERVER_HOST=127.0.0.1
QWEN3_SSH_HOST=qwen3-server
QWEN3_INGEST_PORT=18080
QWEN3_ACTIONS_PORT=28081
QWEN3_OS_FAULT_ROOT=/home/xrh/qwen3_os_fault
QWEN3_VENV=/home/xrh/qwen3_os_fault/.venv_qwen3
QWEN3_TCP_INBOX=/home/xrh/qwen3_os_fault/storage/tcp_inbox
QWEN3_TCP_OUT=/home/xrh/qwen3_os_fault/storage/tcp_out
QWEN3_RUNS_ROOT=/home/xrh/qwen3_os_fault/storage/runs
